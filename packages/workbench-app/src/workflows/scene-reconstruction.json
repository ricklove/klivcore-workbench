                }
            ],
            "data": {
                "value": "scene view with a camera locked to a projection camera position at a specific frame\n\n=> adjust the current frame camera position to align the most pixels"
            }
        },
        {
            "id": "n-string-1768580510888",
            "type": "string",
            "position": {
                "x": 480,
